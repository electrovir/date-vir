{
    "name": "@date-vir/mono-root",
    "version": "9.1.0",
    "private": true,
    "homepage": "https://github.com/electrovir/date-vir",
    "bugs": {
        "url": "https://github.com/electrovir/date-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/date-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "compile": "npm run init && virmator compile",
        "docs": "npm run compile && NODE_OPTIONS=\"--import tsx\" npm run --workspace=date-vir docs",
        "format": "virmator format",
        "init": "tsx node_modules/@augment-vir/node/src/scripts/fix-ts-bin.script.ts",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "mono-vir for-each npm run test",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "mono-vir for-each npm run test:coverage",
        "test:deps": "virmator deps check",
        "test:docs": "NODE_OPTIONS=\"--import tsx\" virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each npm run test:update"
    },
    "overrides": {
        "@playwright/test": "1.60.0",
        "@web/dev-server-rollup": "0.6.1",
        "esbuild": "^0.28.1",
        "is-generator-function": "1.1.0",
        "playwright": "1.60.0",
        "playwright-core": "1.60.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.1",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.3",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^73.0.0",
        "markdown-code-example-inserter": "^3.0.6",
        "mono-vir": "^2.5.1",
        "npm-check-updates": "^23.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.6",
        "typescript-eslint": "8.66.0",
        "virmator": "^14.30.5"
    },
    "engines": {
        "node": ">=22"
    }
}
